{
  "manifest_version": 3,
  "name": "ShieldLens — Browser Security & Download Guard",
  "short_name": "ShieldLens",
  "version": "1.0.0",
  "description": "Defensive security extension providing pre-click link analysis (HoverGuard), expected vs actual file verification (FileGuard), and unauthorized download detection.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "ShieldLens Security Dashboard"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "test/test-playground.html",
        "assets/icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
